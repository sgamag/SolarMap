FROM node:24-alpine AS build

WORKDIR /app

COPY frontend/solarmapuem-main/package*.json ./

RUN npm install

COPY frontend/solarmapuem-main ./

RUN npm run build


FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY docker/nginx_solarmap.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]